# Ignore all files
*

# Except these folders
!/src/
!/include/
!/libft/

# Allow these files too
# CAUTION: to allow files just using filenames not absolute path, make sure the parent folder is unignored first
!/Makefile
!/README.md
!/checker_linux
!/src/*.c
!/include/*.h
!/libft/*.c
!/libft/Makefile

# Re-ignore specific files within allowed directories
/src/*.swp

# Don't forget to allow this file itself!
!/.gitignore
